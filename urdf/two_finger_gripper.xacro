<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="two_finger_gripper">

  <xacro:macro name="two_finger_gripper" params="parent *origin">

    <joint name="gripper_base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="gripper_base"/>
    </joint>

    <!-- THANH ĐẾ GRIPPER -->
    <link name="gripper_base">
      <visual>
        <origin xyz="0 0 0.008" rpy="0 0 0"/>
        <geometry><box size="0.025 0.08 0.016"/></geometry>
        <material name="dark_gray"><color rgba="0.2 0.2 0.2 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.008" rpy="0 0 0"/>
        <geometry><box size="0.025 0.08 0.016"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.008" rpy="0 0 0"/>
        <mass value="0.25"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- NGÓN TRÁI -->
    <joint name="left_finger_joint" type="prismatic">
      <parent link="gripper_base"/>
      <child link="left_finger"/>
      <origin xyz="0 0.040 0.016" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="0.024" effort="150.0" velocity="0.05"/>
      <dynamics damping="15.0" friction="10.0"/>
    </joint>

    <link name="left_finger">
      <visual>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry><box size="0.02 0.01 0.05"/></geometry>
        <material name="silver"><color rgba="0.8 0.8 0.8 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry><box size="0.02 0.01 0.05"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.000005"/>
      </inertial>
    </link>

    <!-- NGÓN PHẢI -->
    <joint name="right_finger_joint" type="prismatic">
      <parent link="gripper_base"/>
      <child link="right_finger"/>
      <origin xyz="0 -0.040 0.016" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="0.024" effort="150.0" velocity="0.05"/>
      <dynamics damping="15.0" friction="10.0"/>
      <mimic joint="left_finger_joint" multiplier="1.0" offset="0.0"/>
    </joint>

    <link name="right_finger">
      <visual>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry><box size="0.02 0.01 0.05"/></geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry><box size="0.02 0.01 0.05"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.000005"/>
      </inertial>
    </link>

    <!-- TÍNH CHẤT VẬT LÝ -->
    <gazebo reference="gripper_base">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <gazebo reference="left_finger">
      <material>Gazebo/Grey</material>
      <mu1>1000.0</mu1>
      <mu2>1000.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.0</maxVel>
    </gazebo>

    <gazebo reference="right_finger">
      <material>Gazebo/Grey</material>
      <mu1>1000.0</mu1>
      <mu2>1000.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.0</maxVel>
    </gazebo>

    <!-- ROS 2 CONTROL -->
    <ros2_control name="GripperHardwareInterface" type="system">
      <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>
      <joint name="left_finger_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>