<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
             iyy="${m * (x*x + z*z) / 12.0}" iyz="0"
             izz="${m * (x*x + y*y) / 12.0}"/>
  </xacro:macro>

  <xacro:macro name="parallel_gripper" params="parent sim_gazebo:=false max_opening:=0.045 initial_opening:=0.045 tcp:=0.07">
    <xacro:property name="base_x" value="0.05"/>
    <xacro:property name="base_y" value="0.13"/>
    <xacro:property name="base_z" value="0.03"/>
    <xacro:property name="finger_x" value="0.048"/>
    <xacro:property name="finger_y" value="0.012"/>
    <xacro:property name="finger_z" value="0.055"/>

    <joint name="gripper_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="gripper_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="gripper_base_link">
      <visual>
        <origin xyz="0 0 ${base_z / 2}" rpy="0 0 0"/>
        <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
        <material name="gripper_dark"><color rgba="0.18 0.18 0.2 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${base_z / 2}" rpy="0 0 0"/>
        <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${base_z / 2}" rpy="0 0 0"/>
        <mass value="0.3"/>
        <xacro:box_inertia m="0.3" x="${base_x}" y="${base_y}" z="${base_z}"/>
      </inertial>
    </link>

    <xacro:macro name="finger" params="side sign">
      <link name="${side}_finger_link">
        <!-- Đệm cao su phẳng độ bám cao (ôm trọn mặt tiếp xúc 4cm của khối hộp) -->
        <visual>
          <origin xyz="0 ${sign * finger_y / 2} ${finger_z / 2}" rpy="0 0 0"/>
          <geometry><box size="${finger_x} ${finger_y} ${finger_z}"/></geometry>
          <material name="rubber_black"><color rgba="0.1 0.1 0.1 1"/></material>
        </visual>
        <collision>
          <origin xyz="0 ${sign * finger_y / 2} ${finger_z / 2}" rpy="0 0 0"/>
          <geometry><box size="${finger_x} ${finger_y} ${finger_z}"/></geometry>
        </collision>

        <inertial>
          <origin xyz="0 ${sign * finger_y / 2} ${finger_z / 2}" rpy="0 0 0"/>
          <mass value="0.05"/>
          <xacro:box_inertia m="0.05" x="${finger_x}" y="${finger_y}" z="${finger_z}"/>
        </inertial>
      </link>

      <joint name="${side}_finger_joint" type="prismatic">
        <parent link="gripper_base_link"/>
        <child link="${side}_finger_link"/>
        <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
        <axis xyz="0 ${sign} 0"/>
        <limit lower="0.0" upper="${max_opening}" effort="300.0" velocity="0.5"/>
        <dynamics damping="20.0" friction="0.0"/>
      </joint>

      <gazebo reference="${side}_finger_link">
        <mu1>100.0</mu1>
        <mu2>100.0</mu2>
        <kp>50000.0</kp>
        <kd>50.0</kd>
        <minDepth>0.002</minDepth>
        <maxVel>0.001</maxVel>
        <material>Gazebo/Black</material>
      </gazebo>
      <gazebo reference="${side}_finger_joint">
        <implicitSpringDamper>true</implicitSpringDamper>
      </gazebo>
    </xacro:macro>

    <xacro:finger side="left" sign="1"/>
    <xacro:finger side="right" sign="-1"/>

    <link name="gripper_tcp"/>
    <joint name="gripper_tcp_joint" type="fixed">
      <parent link="gripper_base_link"/>
      <child link="gripper_tcp"/>
      <origin xyz="0 0 ${tcp}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="gripper_base_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <xacro:if value="${sim_gazebo}">
      <ros2_control name="GripperGazeboSystem" type="system">
        <hardware>
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        <joint name="left_finger_joint">
          <command_interface name="position"/>
          <state_interface name="position"><param name="initial_value">${initial_opening}</param></state_interface>
          <state_interface name="velocity"/>
        </joint>
        <joint name="right_finger_joint">
          <command_interface name="position"/>
          <state_interface name="position"><param name="initial_value">${initial_opening}</param></state_interface>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>
    </xacro:if>
  </xacro:macro>
</robot>